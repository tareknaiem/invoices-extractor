# Invoices Extractor — ignore rules (see constitution.md, Rule 2).

# --- Virtual environments ---------------------------------------------------
venv/
.venv/
env/
ENV/

# --- Python bytecode & caches -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# --- Secrets / local configuration (never commit) ---------------------------
.env
.env.*
!.env.example

# --- Temporary files --------------------------------------------------------
*.tmp
*.temp
*.log
# Office lock files (e.g. ~$Invoice.xlsx):
~$*
Thumbs.db
.DS_Store
